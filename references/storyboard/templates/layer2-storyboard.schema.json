{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CinematicDirectorStoryboardV2",
  "description": "Layer 2 Canonical SSoT Schema for AI Film & Anime Storyboard Director Skill v2.0",
  "type": "object",
  "required": [
    "project_id",
    "scene_id",
    "segment_id",
    "metadata",
    "continuity_handshake",
    "shots",
    "segment_end_state"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "segment_id": {
      "type": "string"
    },
    "source_scene_id": {
      "type": "string",
      "description": "Optional. Scene ID from the upstream handoff JSON (e.g. EP01-S01)"
    },
    "grid_preview_file": {
      "type": "string"
    },
    "storyboard_panels": {
      "type": "array",
      "description": "Optional. 1:1 mapping manifest between 3x3 grid panels and shot IDs",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "shot_id": {
            "type": "string"
          },
          "panel_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "rejected"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "locked": {
          "type": "boolean"
        },
        "reviewer_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        }
      }
    },
    "style_lock": {
      "type": "object",
      "description": "Optional. Locked style description reused by every shot",
      "properties": {
        "anchor": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "lighting_lock_line": {
          "type": "string"
        },
        "continuity_anchors": {
          "type": "object",
          "properties": {
            "lighting": {
              "type": "string"
            },
            "axis": {
              "type": "string"
            },
            "blocking": {
              "type": "string"
            },
            "texture": {
              "type": "string"
            }
          }
        },
        "tail_freeze_hold": {
          "type": "boolean"
        }
      }
    },
    "asset_refs": {
      "type": "object",
      "description": "Optional. Asset IDs this segment depends on (see assets.md)",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(C|CREATURE)-[A-Za-z0-9-]+$"
              },
              "costume_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "scene_id": {
          "type": "string"
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character_id": {
                "type": "string"
              },
              "voice_id": {
                "type": "string"
              }
            }
          }
        },
        "primary_character": {
          "type": "string",
          "description": "Optional. The one character bound as <Subject 1> reference image for this segment (default: heaviest close-up weight; narrator never)"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "target_duration_sec",
        "pacing_profile",
        "lighting_lock_line"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "2.39:1",
            "1:1"
          ]
        },
        "target_duration_sec": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 60.0
        },
        "pacing_profile": {
          "type": "string",
          "enum": [
            "Slow_Cinematic",
            "Standard_Narrative",
            "Fast_ShortDrama"
          ]
        },
        "palette_preset": {
          "type": "string"
        },
        "lighting_lock_line": {
          "type": "string"
        },
        "mood_en": {
          "type": "string",
          "description": "Optional. One English clause for the H3 summary"
        },
        "music_en": {
          "type": "string",
          "description": "Optional. English non_diegetic_music line"
        },
        "soundscape_en": {
          "type": "string",
          "description": "Optional. English overall_soundscape line"
        },
        "primary_character": {
          "type": "string"
        },
        "interior": {
          "type": "boolean",
          "description": "Optional. 室內（true）／戶外（false）。h3d staging W46 構圖板建議用；沒寫時改讀 handoff 場景的 setting.interior／int_ext，都沒有就不建議"
        }
      }
    },
    "continuity_handshake": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "SEAMLESS_CONTINUATION",
            "HARD_CUT_ESTABLISH",
            "INDEPENDENT_REF2VA"
          ]
        },
        "inherited_from_segment": {
          "type": [
            "string",
            "null"
          ]
        },
        "overflow_dialogue_in": {
          "type": [
            "string",
            "null"
          ]
        },
        "overflow_dialogue_out": {
          "type": [
            "string",
            "null"
          ]
        },
        "persistent_world_state": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ViMax-style dependency graph tracking irreversible prop/character states (e.g., 'white envelope is creased', 'cup is shattered')"
        }
      }
    },
    "seam_in": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "cut",
        "cont",
        null
      ],
      "description": "Optional. 本段和上一段的段縫類型（references/storyboard/shot-transitions.md §1）：cut＝換機位硬切、讓模型重建（D15 三選一閘門）；cont＝同機位技術分段（D18；上段末 1 s 定格無台詞、本段同景別起手＋entry_state 交接塊）。null／省略＝未規劃，D15／D18 不跑。和 continuity_handshake.mode（生成路線）是兩件事。"
    },
    "entry_state": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional. 本段 0.0 s 的絕對起始狀態（CONT 段縫交接塊來源）：扁平 {position, facing, distance, momentum, damage, holding, background_anchor, light, sound} 或 {<角色 id>: {同欄位}}。逐項寫，禁寫「承接上一段／同上」（D18）。編譯器只在 seam_in=cont 時把英文值寫進第 1 鏡開頭。"
    },
    "entry_state_en": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional. entry_state 的英文版（entry_state 是中文時給編譯器用；也可放在階段 5 en_overlay.entry_state_en）。"
    },
    "exit_state": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional. 本段最後一格的狀態，欄位同 entry_state；下一段 seam_in=cont 時 D18 逐欄比對。"
    },
    "narrative_scene_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional. 敘事場景 ID（shot-transitions.md §7）。scene_id 一段一個場景包（S-buffet-fight-a／-b…）時要寫，段縫規則 D15／D18／D22–D24 的同場判斷依序看 narrative_scene_id → source_scene_id → scene_id。"
    },
    "beats_done": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Optional. 事件帳：本段開始前已完成的 beat ID（shot-transitions.md §4.5）。已發生的事在動作描述寫成靜止狀態（已站起、still standing），不用動作詞重述；D22 檢查。"
    },
    "beats_new": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Optional. 事件帳：本段新做的 beat ID；同一 ID 在同場只能新做一次（D22）。"
    },
    "lead_in_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 3,
      "description": "Optional. 拋棄式前導秒數（選用、預設不寫＝關；shot-transitions.md §4.4）：段頭這幾秒照起始狀態靜止，編譯器在第 1 鏡寫前導句，h3d assemble 自動剪掉；段長要多留這段時間。建議 0.5–1.5。"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "start_time",
          "end_time",
          "duration",
          "shot_intent",
          "choice_why",
          "camera_optics",
          "spatial_blocking",
          "action_and_performance",
          "dialogue_and_audio"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reference image file paths fed to this shot"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "image_done",
              "video_done",
              "skipped"
            ]
          },
          "image_file": {
            "type": "string"
          },
          "video_file": {
            "type": "string"
          },
          "sketch_file": {
            "type": "string",
            "description": "Path to 1:1 pencil sketch panel image for this shot"
          },
          "sketch_sha256": {
            "type": "string",
            "description": "SHA256 hash of the pencil sketch panel file for zero-contamination verification"
          },
          "h3_loras": {
            "type": "array",
            "description": "Optional. Auto-adapted or manually specified MiniMax H3 LoRAs for this shot",
            "items": {
              "type": "object",
              "required": [
                "name",
                "strength"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "strength": {
                  "type": "number",
                  "minimum": -4.0,
                  "maximum": 4.0
                },
                "trigger": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "review_status": {
                "type": "string",
                "enum": [
                  "draft",
                  "pending_review",
                  "approved",
                  "rejected"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "locked": {
                "type": "boolean"
              },
              "reviewer_note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "type": "string"
              },
              "shot_hash": {
                "type": "string"
              }
            }
          },
          "start_time": {
            "type": "number",
            "minimum": 0.0
          },
          "end_time": {
            "type": "number",
            "minimum": 0.5
          },
          "duration": {
            "type": "number",
            "minimum": 0.5
          },
          "dramatic_beat_type": {
            "type": "string",
            "enum": [
              "Expository_Fast",
              "Suspense_Delay",
              "Dramatic_Core",
              "Combat_Impact",
              "Reaction_OTS"
            ]
          },
          "shot_intent": {
            "type": "object",
            "description": "必填，且要在寫 camera_optics 之前先想好。這一鏡要讓觀眾看懂／感受到什麼；所有技術選擇都從這裡推出（references/storyboard/shot-intent.md）。validate_storyboard.py I01/I03/I04。",
            "required": [
              "audience",
              "story_beat",
              "pov",
              "emotional_shift"
            ],
            "properties": {
              "audience": {
                "type": "string",
                "minLength": 6,
                "description": "觀眾看完這一鏡必須看懂或感受到的一件事"
              },
              "story_beat": {
                "type": "string",
                "minLength": 6,
                "description": "這一鏡推進的劇情節拍"
              },
              "pov": {
                "type": "string",
                "minLength": 6,
                "description": "誰的視角；觀眾站在誰那邊"
              },
              "emotional_shift": {
                "type": "string",
                "minLength": 6,
                "description": "情緒從哪裡變到哪裡"
              }
            }
          },
          "choice_why": {
            "type": "object",
            "description": "必填。每個技術選擇一句「為什麼」，要扣回 shot_intent；不可抄技術值、不可跨鏡套句。validate_storyboard.py I02/I03/I05/I06。",
            "required": [
              "shot_size",
              "lens_distance",
              "movement",
              "blocking",
              "background"
            ],
            "properties": {
              "shot_size": {
                "type": "string",
                "minLength": 6,
                "description": "景別理由"
              },
              "lens_distance": {
                "type": "string",
                "minLength": 6,
                "description": "焦距與物距理由"
              },
              "movement": {
                "type": "string",
                "minLength": 6,
                "description": "運鏡（含固定）理由"
              },
              "blocking": {
                "type": "string",
                "minLength": 6,
                "description": "人物佔位、畫面位置、視線理由"
              },
              "background": {
                "type": "string",
                "minLength": 6,
                "description": "背景要露場景圖裡的什麼、為什麼；不准寫 empty 交差"
              },
              "line_timing": {
                "type": "string",
                "minLength": 6,
                "description": "有台詞時必填：台詞相對動作／運鏡何時開口、為什麼"
              }
            }
          },
          "camera_optics": {
            "type": "object",
            "required": [
              "shot_size",
              "focal_length",
              "physical_distance",
              "pov_routing",
              "movement"
            ],
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": [
                  "ELS",
                  "LS",
                  "MLS",
                  "MS",
                  "MCU",
                  "CU",
                  "ECU",
                  "OTS_MS",
                  "OTS_CU"
                ]
              },
              "focal_length": {
                "type": "string",
                "enum": [
                  "14mm",
                  "24mm",
                  "35mm",
                  "50mm",
                  "85mm",
                  "100mm",
                  "135mm"
                ]
              },
              "physical_distance": {
                "type": "string",
                "description": "Physical camera-to-subject distance (e.g. '<0.5m extreme close' or '>6m telephoto compression')"
              },
              "pov_routing": {
                "type": "string",
                "enum": [
                  "dirty_frame_20_35",
                  "clear_impact_90deg",
                  "defensive_reaction_ots",
                  "reflection_delay",
                  "objective"
                ]
              },
              "movement": {
                "type": "string"
              },
              "axis_side": {
                "type": "string"
              },
              "azimuth_deg": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 360,
                "description": "Optional. 機位方位角（度）＝鏡頭朝向，俯視順時針；0＝本場主機位（站位附表／continuity_anchors.axis 的建立鏡），反打＝180，過肩≈±30（shot-transitions.md §7）。D15（≥90°）／D16（≥30°）／D23／D24 用；沒填就只能看主體與景別"
              }
            }
          },
          "spatial_blocking": {
            "type": "object",
            "required": [
              "anchor_objects",
              "blocking_desc"
            ],
            "properties": {
              "anchor_objects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocking_desc": {
                "type": "string"
              },
              "safe_zone_9x16_passed": {
                "type": "boolean"
              }
            }
          },
          "action_and_performance": {
            "type": "object",
            "required": [
              "action_stages",
              "observable_expression"
            ],
            "properties": {
              "action_stages": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string"
                },
                "description": "Max 5 stages per shot to prevent AI morphing"
              },
              "observable_expression": {
                "type": "string"
              },
              "background_idle_life": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "micro_physics_tail": {
                "type": "string"
              },
              "action_stages_en": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string"
                },
                "description": "English force-origin / transfer / reaction stages used by compile_layer2_to_h3 (H3 English prompt mode, lint E15)"
              },
              "observable_expression_en": {
                "type": "string",
                "description": "English observable expression for the H3 prompt"
              },
              "five_part_en": {
                "type": "object",
                "description": "Stage 5, hand-written per shot by the agent after reading this shot's storyboard row, sketch and the previous shot's end state (references/prompt-authoring.md). Compiled verbatim as Camera/Motion/Performance/Light/Sound; never generated by a script.",
                "required": [
                  "camera",
                  "motion",
                  "performance",
                  "light",
                  "sound"
                ],
                "additionalProperties": false,
                "properties": {
                  "camera": {
                    "type": "string",
                    "minLength": 1
                  },
                  "motion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "performance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "light": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sound": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "dialogue_and_audio": {
            "type": "object",
            "required": [
              "has_dialogue",
              "lips_closed_lock"
            ],
            "properties": {
              "has_dialogue": {
                "type": "boolean"
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line_verbatim": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "voice_4d_spec": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "voice_4d_spec_en": {
                "description": "English voice descriptor (timbre, register, delivery). The H3 prompt compiler writes this field into the English prompt body; a Chinese voice_4d_spec is not pasted into the prompt.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "delivery_timing_anchor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lips_closed_lock": {
                "type": "boolean"
              },
              "audio_bridge": {
                "type": "string",
                "enum": [
                  "NONE",
                  "J_CUT",
                  "L_CUT",
                  "HARD_CUT"
                ]
              },
              "foley_and_ambience": {
                "type": "string"
              }
            }
          },
          "cut_in": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional. 這一刀怎麼切進本鏡（shot-transitions.md §2）。第 1 鏡不用寫（寫了也不看），段縫看段層 seam_in。",
            "properties": {
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "hard",
                  "match_action",
                  "eyeline",
                  "reaction",
                  "insert",
                  "scene_change",
                  "cont",
                  null
                ]
              },
              "motivation": {
                "type": "string",
                "description": "切的動機：新資訊／視線／動作／聲音；越軸或換位時寫轉折理由（D20 會讀）"
              }
            }
          },
          "positions": {
            "type": "array",
            "description": "Optional. 逐鏡站位（世界座標＋畫面座標雙層，shot-transitions.md §5）。D20 比相鄰鏡左右順序、世界位置、動作匹配畫面位置；D21（建議）要每人 background_anchor；D23 比朝向和被看的人在哪邊；D24 比反打有沒有換邊。",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "order_lr": {
                  "type": "integer",
                  "description": "本機位畫面左到右順序，1＝最左"
                },
                "facing": {
                  "type": "string",
                  "description": "朝向／視線所在邊，例 frame_right、frame_left toward C-02；toward＝朝鏡頭（D06）。寫畫左／畫右又指名看誰時，被看的人要在同一邊（D23）"
                },
                "toward": {
                  "type": "string",
                  "description": "Optional. 這人看誰（角色 ID）；D23 檢查被看的人是否在 facing 寫的那一邊"
                },
                "background_anchor": {
                  "type": "string",
